<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jhansenwmi.tv-schedule</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos/update_tv_schedule.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos</string>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/tv-schedule.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/tv-schedule.log</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
