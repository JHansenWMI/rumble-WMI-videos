<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jhansenwmi.radio-schedule</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos/update_radio_schedule.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos</string>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/radio-schedule.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/radio-schedule.log</string>

  <!--
  Friday 4:10am — after daily rumble-feed at 4:00. TV schedule is Friday 4:20
  (com.jhansenwmi.tv-schedule) so these two do not share the git repo.

  launchd Weekday: 0=Sunday … 5=Friday, 6=Saturday.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>