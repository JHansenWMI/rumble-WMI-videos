<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jhansenwmi.rumble-feed</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos/publish_rumble_feed.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos</string>

  <!--
  Environment variables for the scheduled job.

  RUMBLE_FEED_MODE controls failure behavior for parser changes (Rumble HTML updates):

  - Unset or "production" (the DEFAULT): safe/dumb mode.
    The production Mac Mini can simply `git pull` with its existing plist.
    On "No Rumble items found" error: short message only, exit.
    No auto-capture of samples, no git commit/push from this machine.

  - "development": rich mode.
    Use this on your dev MacBook so that when you (or its launchd) hit a parser
    failure you get:
    - auto-captured sample dir (pushed to git)
    - a bounded headless Grok attempt (--max-turns, --effort low)
    Parser edits are saved as a .diff in the sample dir, then the working tree
    is restored. See samples/rumble-channel-pages/README.md.

  After editing the installed plist, remember to unload/reload:
    launchctl unload ~/Library/LaunchAgents/com.jhansenwmi.rumble-feed.plist
    launchctl load   ~/Library/LaunchAgents/com.jhansenwmi.rumble-feed.plist
  -->
  <!--
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUMBLE_FEED_MODE</key>
    <string>development</string>
  </dict>
  -->

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/rumble-feed.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/rumble-feed.log</string>

  <key>StartCalendarInterval</key>
  <array>
