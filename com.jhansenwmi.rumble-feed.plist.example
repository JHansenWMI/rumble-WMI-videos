<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jhansenwmi.rumble-feed</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/USERNAME/PATH/TO/rumble-WMI-videos &amp;&amp; ./rumble_feed_tick.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/PATH/TO/rumble-WMI-videos</string>

  <!--
  Tick: rumble_feed_tick.sh
    :05 :20 :35 :50 every hour (offset +5 — uploads often land on the hour).
    Full proven scrape at 4:05am, 8:05am, 5:05pm, 8:05pm Pacific.
    Other ticks: one GET of rumble.com/user/DrJonathanHansenWMI; full scrape only if that fingerprint changed.

  RUMBLE_FEED_MODE (optional EnvironmentVariables):
    unset / production — Mini: safe parser failure, JSON-only unattended recovery.
    development — laptop: sample capture + bounded Grok on parser failure.

  After editing the installed plist:
    launchctl unload ~/Library/LaunchAgents/com.jhansenwmi.rumble-feed.plist
    launchctl load   ~/Library/LaunchAgents/com.jhansenwmi.rumble-feed.plist
  -->

  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/rumble-feed.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/rumble-feed.log</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>20</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>35</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
